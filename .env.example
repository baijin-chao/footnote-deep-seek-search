# ============================================================
# Deep Research Agent · 环境配置模板
# 用法：复制为 .env，填入密钥。.env 已被 .gitignore 排除。
# ============================================================

# ---------- 运行模式 ----------
# live   真实调用外部 API
# record 真实调用，同时把响应录到 fixtures/（用于后续回放）
# mock   只读 fixtures/，不联网（离线开发、演示兜底）
RUN_MODE=live

# ---------- LLM（DeepSeek，OpenAI 兼容协议）----------
# 默认主力：deepseek-flash（V4.1-Flash-1017，最新且便宜 4.4 倍）
# 升级档：deepseek-v4-pro（V4-Pro-0813），仅用于困难 case 的对照实验
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_MODEL_STRONG=deepseek-v4-pro
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# 计价：美元 / 百万 token，取自官方定价页（峰值价，保守估计）
# deepseek-flash  : 输入 $0.30  输出 $1.20
# deepseek-v4-pro : 输入 $1.32  输出 $3.96
PRICE_MAIN_INPUT=0.30
PRICE_MAIN_OUTPUT=1.20
PRICE_STRONG_INPUT=1.32
PRICE_STRONG_OUTPUT=3.96
USD_TO_CNY=7.2

# ---------- 搜索 ----------
# tavily 为主，bocha 为备（V1 的多 provider 降级链要用到两个）
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
BOCHA_API_KEY=
SEARCH_MAX_RESULTS=8
SEARCH_TIMEOUT=20

# ---------- 网页抓取 ----------
FETCH_TIMEOUT=20
FETCH_MAX_BYTES=3000000
FETCH_CONCURRENCY=4

# ---------- 预算与终止条件 ----------
BUDGET_MAX_STEPS=25
BUDGET_MAX_TOKENS=60000
BUDGET_MAX_CNY=0.6
BUDGET_MAX_SECONDS=120
REFLECT_MAX_ROUNDS=2

# ---------- 存储 ----------
DB_PATH=./.work/dra.db
TRACE_DIR=./.work/traces
FIXTURES_DIR=./fixtures

# ---------- Web 服务 ----------
APP_HOST=127.0.0.1
APP_PORT=8710

# ---------- 日志 ----------
LOG_LEVEL=INFO
